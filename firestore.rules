rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'daughtridgeinvestmentgroup@gmail.com';
    }

    match /inquiries/{id} {

      // Only the owner/admin can view, edit, or delete inquiries.
      allow read, update, delete: if isOwner();

      // Website visitors can submit a new inquiry.
      // They cannot read the inquiry after submitting it.
      allow create: if
        request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.propertyAddress is string
        && request.resource.data.propertyType is string
        && request.resource.data.ownerName is string
        && request.resource.data.parcelPin is string
        && request.resource.data.acreage is string
        && request.resource.data.additionalNote is string
        && request.resource.data.referenceNumber is string
        && request.resource.data.smsConsent is bool
        && request.resource.data.termsAccepted == true
        && request.resource.data.privacyAccepted == true
        && request.resource.data.status == 'New'
        && request.resource.data.submittedAt is timestamp;
    }

    match /counters/{day} {
      allow read, write: if false;
    }
  }
}
